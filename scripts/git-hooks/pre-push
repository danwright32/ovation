#!/bin/bash
# Refuse a push whose suite is red.
#
# ovation#11. This runs on EVERY push from this clone, whoever makes it: Dan's
# terminal, Xcode's source control panel, any git client. That is why it exists
# separately from the harness level gates, which only see pushes made through
# Claude Code.
#
# It runs through scripts/run-tests.sh, so a push locks exactly as an ordinary
# test run does (ovation#12): the pure suite runs without waiting for Downbeat or
# Overture, and both siblings' locks are taken around the hosted suite, the half
# measured to disturb a sibling's run (ovation#271).
#
# JUDGED BY EXIT CODE, never by a line of output. A tool's final line is
# routinely a different measurement than its verdict, and usually the more
# reassuring of the two (L184).
#
# SCOPE, stated so its limits are not mistaken for coverage: this checks that the
# suite is green. It does NOT yet check the things the plan wants a pre-push to
# check, because the guards do not exist yet. Each is added by the issue that
# builds it, rather than being listed here as if it were already covered:
#   the identity guard                      ovation#5, added below
#   the custody never staged check          ovation#4, added below
#   the ported artifact ancestry check      added below
set -uo pipefail

# THE TREE BEING PUSHED, NOT THE TREE THIS FILE LIVES IN (ovation#138).
#
# This was derived from the hook file's own location. core.hooksPath had been
# left as an absolute path into the primary checkout, so a push from a worktree
# ran the primary checkout's hook against the primary checkout's tree and the
# primary checkout's copy of every guard beside it. The branch being pushed was
# never looked at: a gate reading its criteria from a revision it is not judging
# (L398). It failed in both directions, and the one that bit was a green branch
# refused for a fault that existed only in the primary checkout, whose fix was
# already committed on the branch being refused.
#
# git runs a pre-push with its working directory at the top of the tree the push
# comes from, which is what makes this the right question to ask, and
# scripts/test-git-hooks.sh measures that with a real push rather than trusting
# it (L82). The installer now also writes core.hooksPath in its relative form and
# upgrades an absolute one, so the FILE that runs comes from the pushed tree too.
#
# REFUSED, NOT GUESSED, when the question cannot be answered: a hook always runs
# inside a repository, so a failure here means something is wrong with the
# invocation and falling back to this file's location is how the defect above got
# in (L93, L173).
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -z "${REPO_ROOT}" ] || [ ! -d "${REPO_ROOT}" ]; then
    echo "pre-push: could not work out which working tree is being pushed." >&2
    echo "pre-push: 'git rev-parse --show-toplevel' answered nothing, so nothing" >&2
    echo "pre-push: has been checked. Push refused." >&2
    exit 1
fi

# The documented one push escape hatch. It ANNOUNCES itself, because an override
# that can happen quietly is one that happens by accident, and it is good for
# this one push only.
if [ -n "${SKIP_TEST_RUN:-}" ]; then
    echo "pre-push: SKIP_TEST_RUN is set, so the suite was NOT run." >&2
    echo "pre-push: this push is going out unverified, deliberately." >&2
    exit 0
fi

# ---------------------------------------------------------------------------
# ONE PLACE THE POLICY LIVES, AND EXIT CODES RATHER THAN TRUTHINESS (ovation#135).
#
# Every check below was its own copy of `if ! script; then <one sentence>; exit
# 1; fi`. A check that had gone to real trouble to keep three outcomes apart then
# had two of them collapsed into the sentence that sends somebody hunting for a
# leak that is not there, and the identity guard's sources live outside the
# repository, so NOBODY BUT THIS MAC COULD PUSH: a fresh clone, Dan's second
# machine and a CI runner were each told the tree was contaminated (L11, L148).
#
# DAN'S DECISION, 2026-09-08: refuse only when the machine SHOULD have been able
# to measure. The checks carry that in their codes, because each one knows why it
# could not answer and this hook does not (L621, L70):
#
#   0            passed
#   2            could not measure, and nothing on this machine ever could have.
#                Allowed, and NAMED, because a check that went unrun and a check
#                that passed must never read the same (L98).
#   4            could not measure, and this machine had what it needs. Refused:
#                that is a fault here.
#   anything else refused, with that check's own sentence.
#
# Ten copies of a case statement is ten places for the policy to drift, so it is
# written once and every check goes through it (L30, L613).
UNMEASURED=""

# A THIRD ARGUMENT NAMES THE EXIT CODE THAT MEANS "NOT ANSWERABLE HERE", and it
# defaults to 2, which is what every guard in this repository uses. It exists for
# check-plan-claims.sh (ovation#181), whose own vocabulary separates a sibling
# repository not being on this machine (3) from the siblings being there and
# nothing having been comparable (2). Those are this gate's two unmeasured
# outcomes exactly, in the opposite order.
#
# IT IS DECLARED PER CALL SITE rather than taught to every check, because 3 means
# REFUSE to every other guard here and putting a second rule behind one shared
# code would quietly widen all of them (L448). The suite holds that: a guard that
# declares no code of its own still refuses on 3.
gate_check() {
    local name="$1" refusal="$2" unmeasured="${3:-2}"
    local script="${REPO_ROOT}/scripts/${name}"
    # A CHECK NAMED HERE AND MISSING FROM THE TREE IS A REFUSAL, not a skip. The
    # hook and the scripts now come from the same revision (ovation#138), so a
    # name here with no file there is an inconsistent tree, and skipping it would
    # be the gate silently dropping a check while still reporting green (L96,
    # L98). The suite stages a stub for every name this file lists, so the list
    # and the tree cannot drift apart untested.
    if [ ! -x "${script}" ]; then
        echo "pre-push: ${name} is named by this gate and is not executable at" >&2
        echo "pre-push: ${script}. The gate cannot run a check it cannot find," >&2
        echo "pre-push: and will not pass a push it did not check. Push refused." >&2
        exit 1
    fi
    "${script}"
    local status=$?
    # THE DECLARED CODE IS TESTED FIRST AND ON ITS OWN, never folded onto 2. A
    # call site that names 3 is saying 3 is its only unmeasured outcome, so its 2
    # must reach the refusal below like any other code: for check-plan-claims.sh
    # exit 2 means the siblings WERE here and nothing could be compared, which is
    # a fault, and an earlier version that remapped 3 onto 2 let that through.
    if [ "$status" = "$unmeasured" ]; then
        UNMEASURED="${UNMEASURED}${name} "
        echo "pre-push: ${name} could not be measured here (see above)." >&2
        echo "pre-push: nothing on this machine could have answered it, so the" >&2
        echo "pre-push: push is not refused for it. What it covers went unchecked." >&2
        return 0
    fi
    case "$status" in
        0) return 0 ;;
        4)
            echo "pre-push: ${name} could not be measured, although this machine has" >&2
            echo "pre-push: what it needs to. That is a fault here rather than in the" >&2
            echo "pre-push: tree, and it is not a pass. Push refused." >&2
            exit 1
            ;;
        *)
            echo "pre-push: ${refusal} Push refused." >&2
            exit 1
            ;;
    esac
}

# The ported artifact check first: it is seconds, it needs no lock, and it
# catches a port made from a stale checkout before a full suite is paid for.
# CANNOT MEASURE (exit 2) is not a pass, so it blocks too, and NO PORTED
# ARTIFACTS (exit 3) is only correct until the first port lands.
gate_check check-ported-artifacts.sh "the ported artifact check did not pass."

# Custody next, also seconds and also needing no lock. This is the one that
# matters most while the repository is public: it asks whether a real receipt or
# a real QuickBooks export has ever entered git history, which .gitignore cannot
# answer, because an ignore entry added after a file was committed hides it from
# git status while leaving it in every clone.
gate_check check-custody-not-staged.sh "custody data reached git."

# The identity guard last of the three fast checks, because it walks the whole
# tree. It refuses if a real client, venue or vendor name appears anywhere,
# including in files .gitignore excludes, and it prints paths and counts only.
gate_check check-identity-leaks.sh "a real identity appears in the tree."

# The constructs Ovation has ruled out: floating point money (plan 1.4), the
# ambient calendar (plan 1.5), blocking work on the cooperative pool (plan 1.9),
# and disk work in the code that draws a screen (ovation#255). The scanner's own
# output names which rule fired and why, so this line does not repeat one of them
# as though it were the only one. Fast: it walks Swift files and prints paths,
# line numbers and type names only.
gate_check check-forbidden-constructs.sh "a construct the app rules out reached its sources."

# Every resolver that can reach live data is registered in LiveDataFloor, and
# this is what makes the register true (ovation#58, plan 1.9). A guard driven by
# a hand written list checks only what the list names, so a resolver missing from
# it is exempt from the very check meant to catch it.
gate_check check-isolation-floor.sh "a live data resolver is not in the isolation floor."

# ovation#60. A model type missing from the store's schema simply has no table,
# and SwiftData says nothing about it: the first symptom is a fetch that returns
# nothing, at whatever distance from the omission. Same shape as the floor above,
# and the subjects are derived from the sources rather than from a list somebody
# maintains.
gate_check check-schema-registered.sh "a model type is not in the store's schema."

# ovation#262. Code that resolves, filters or counts a problem kind believes the
# kind happens, and when nothing in the app raises it that code does nothing
# while reading as working. The no backup folder notice was resolved in two places
# and raised in none, so the notice a first launch showed never cleared. Its
# subjects are the problem kinds declared in the sources, and tests are not
# scanned, because a test raising a kind by hand is how that went unseen.
gate_check check-problem-kinds-raised.sh "a problem kind is resolved in the app and raised nowhere."

# ovation#124. Ovation has one slide and one fade, and one file that knows whether
# the person asked their Mac to reduce motion. A transition written on a screen
# answers that question for itself or forgets it, and the failure is invisible to
# everybody who could report it: the person who needs reduce motion is not the
# person building the screen, and no test they run goes red. The scanner's own
# output names the construct and the route through the component, so this line
# does not repeat either. Fast: Swift files, and it prints paths, line numbers and
# construct names only.
gate_check check-motion-owner.sh "an animation is written outside the file that owns motion."

# ovation#319, PRD 9 and 41a. The three sentences at the foot of an invoice go to
# clients under Dan's name, and they now come from Settings. A page built from
# `InvoiceFooter.fixed` instead renders perfectly, says something plausible, and
# silently ignores everything he typed, while the settings pane goes on showing his
# text: there is nothing in the output to notice it by, which is why it is caught
# here rather than by somebody re-reading an invoice already sent (L98, L144).
# Fast: one grep per Swift file under Ovation/.
gate_check check-invoice-footer-source.sh "the invoice page is built from the shipped footer text rather than from Settings."
gate_check check-waiting-sentences-agree.sh "a refusal the app says has drifted from the wording settled in the design record."

# ovation#119. `OvationMigrationPlan.stages` is empty and `schemas` names one
# version. Both are correct today and exactly one of them is silently wrong the
# moment a second version is added, because SwiftData does not refuse a missing
# stage: it opens a store that looks fine and the data a renamed property or a
# changed type held is gone. Nothing else in the repository can tell, since an
# empty stages list is the correct value right up until it is not.
gate_check check-migration-stages.sh "the migration plan's versions and stages disagree."

# ovation#114. The design record's whole value is that it outlives whatever
# rendered it: each file is one document that opens in any browser with no
# network, forever, which is why the typefaces are embedded as base64 rather than
# linked. A `<link>` to a font service added by anyone would make that false with
# no symptom at all, because the file goes on rendering perfectly on a machine
# with a network and only fails years later, offline.
gate_check check-design-self-contained.sh "a design file reaches outside itself."

# ovation#111. Because a design file may reach outside itself NEVER, it cannot
# load docs/design/rules/ at render time and carries its own copy of every rule
# it runs. Two copies with nothing comparing them had already drifted: a12b32a
# fixed a NaN defect in typeDigit in the rules and left the design file's copy
# alone, and the suite stayed green because the suite reads the rules. The screen
# the design record IS went on holding the defect, and nothing could say so.
gate_check check-design-rules-inline.sh "a design file's copy of a rule disagrees with docs/design/rules/."

# ovation#201. The design record argues from measured numbers, some asserted by a
# check and most not, and on the page the two look exactly alike. A number nothing
# owns goes stale the first time the thing it measures changes and goes on reading
# as though something were still watching it (L210). The record now marks which is
# which, and this refuses a marking that points at nothing: a check that is not
# there, a check no inventory watches, or a day that is not a date. It does NOT
# refuse a number nobody has marked, and that is the whole design: a gate refusing
# until all of them were marked would be unlandable, and would be answered by
# marking numbers to silence it. Those are counted and reported instead.
gate_check check-design-measurements-marked.sh "a measurement marking in the design record points at nothing."

# ovation#98 round D. The same shape again, for the payment terms. PRD 51h makes
# a client's standing terms and an invoice's own due date ONE list, and the two
# screens that offer it are two files that cannot load a shared constant, so each
# declares its own. A client offered 21 days by a screen no invoice can produce
# one on is two vocabularies for a single thing, and each file reads as correct
# alone. The claim that they cannot drift was made to Dan while he was choosing
# the control; this is what makes it true.
gate_check check-design-terms-agree.sh "the two design files offer different payment terms."

# ovation#199. The repository cites PRD requirements 518 times and nothing
# resolved any of them. A wrong citation is worse than a dangling link: the
# reader follows it, finds a number, and comes away believing the requirement
# says something. The first run found four, all of the same shape, a section
# qualifier naming the section the requirements are NOT in.
gate_check check-prd-citations.sh "a PRD citation names a requirement that is not there."

# ovation#181. check-plan-claims.sh re-checks every claim the implementation plan
# makes about the two sibling repositories, and until now NOTHING ran it: it was
# a tool, run by a person on demand, so the plan drifted from the moment it was
# committed and the first sign was somebody typing the command months later. That
# is what ovation#16 already caught happening, with eight claims drifted and
# nothing able to say so. Worse, the plan carries a sentence at the top saying it
# is re-checkable in one command, which reads as an assurance (L400, L244).
#
# WHY THE GATE AND NOT A SCHEDULE. It reads two checkouts that exist on Dan's Mac
# and on no runner, so a scheduled job would report CANNOT MEASURE every week for
# ever, which is the state that teaches everyone to ignore the whole workflow.
# The gate is the one thing that runs where the checkouts actually are, and it is
# SILENT rather than refusing anywhere else: exit 3, its own code for a sibling
# that is not here, is declared as this call's unmeasured code.
#
# IT REFUSES ON LITTLE. A line that moved is reported and not refused, because
# these are other repositories and a line number in them is stale within the week
# (L538). What refuses is a cited file that is gone, one shorter than the line
# cited, or a path that resolves in more than one repository. Measured before
# wiring it: 42 citations, 27 held, 0 moved, 0 absent, and the whole run took
# under a second.
gate_check check-plan-claims.sh "the plan cites a sibling file that is gone, short or ambiguous." 3

# ovation#120. The same shape, for the shell every design file draws its window
# with: the typefaces, the reset, the desktop, the palette and the window. Each
# file got that shell by copying the last one, and it had already drifted. The
# palette was moved off `.win` and onto `.screen` in invoice.html on 2026-09-08,
# because everything outside the window resolved `var(--anything)` to nothing,
# and the two older files never received the fix. Every file went on rendering.
gate_check check-design-shell-inline.sh "a design file's copy of the shell disagrees with docs/design/shell/."

# ovation#167. review-send.html carries the whole invoice PDF design as one
# escaped string and runs it in a frame, so its preview is the settled document
# only while the two agree. Nothing compared them, and on 2026-09-14 the copy was
# an older page still carrying the blank page bug ovation#170 fixed and a phone
# number the design had dropped. The remedy is scripts/write-design-embedded-page.sh.
gate_check check-design-embedded-page.sh "review-send.html's embedded invoice page disagrees with invoice-pdf.html."

# ovation#166 and ovation#148. Each design file was built by copying the last
# one, so roughly half the largest file's stylesheet described OTHER SCREENS:
# the Clients rows and panels, the invoice list's row treatments, the switcher
# chrome left behind when the chooser was stripped out, and the CSS of an option
# round 1 rejected. Every one of them carried a docstring, so a leftover read as
# a considered decision (L346), and one of them, `.nrow`, is the class name
# collision ovation#120 was filed for. Deleting them once converts the file in
# front of whoever did the deleting and leaves the next copy standing (L613), so
# the deletion and the guard ship together.
gate_check check-design-dead-rules.sh "a design file carries CSS for a screen it does not draw."

# ovation#149. Rounds A to D of ovation#111 produced one popup list and built it
# as TWO, merged in the same change. The component shipped without the guard
# that keeps it the only one, and a shared component created to end N copies
# converts the site in front of whoever built it and leaves the rest standing
# (L613). Three screens are still to be drawn and each wants a short list of
# choices. A rule in the design record would be followed by whoever read it
# (L27), so it is a scan, and it recognises a copy by its SHAPE rather than its
# name, because the name is the thing a copy changes.
gate_check check-design-shared-components.sh "a design file declares a second copy of a shared component."

# ovation#102. The AppIcon catalog is DERIVED from icon/ovation-app-icon.png and
# both are committed. Nothing asserted they were still in step, and both ways it
# goes wrong are silent: the artwork replaced without the script being re-run, so
# the app ships the previous icon while the repository shows the new one, or one
# generated PNG edited by hand, so the shipped icon is something no source here
# produces. The bundle icon check passes in both cases.
# CANNOT MEASURE IS NOT A REFUSAL HERE, and this check is where that was first
# got right: the catalog is committed precisely so a machine without Pillow can
# build the app, so such a machine is expected and must not be unable to push
# (L411). gate_check is that rule made general.
gate_check check-app-icon-current.sh "the committed icon catalog is not what the artwork produces."

# ovation#206. project.yml lists directories and the generated project lists
# files, so a Swift file added since the project was generated is invisible to
# every build, and the first sign was `cannot find ... in scope` from a file that
# plainly referenced it: an error naming the code rather than the project. Asked
# here, in seconds and before the suite, because a push is where a person meets
# it; the runner asks the same script before its Swift suites for a direct run.
# A tree with no generated project answers could not measure (2), which is
# allowed: the next run generates one from these very directories.
gate_check check-xcode-project-current.sh "the generated Xcode project does not list the Swift files on disk; run bash scripts/regenerate-xcode-project.sh."

# The launch sequence must be WIRED into the entry point. ovation#88: the store
# schema guard was written and fully tested and then called by nothing, because
# the file carrying @main is the one file the pure test target cannot compile, so
# no test in the suite can reach the wiring. This is the only instrument there is
# for it, which is exactly why its absence let the first omission stand.
gate_check check-launch-sequence-wired.sh "the entry point does not run the store launch sequence."

# ovation#318. The review sheet is judged over invented invoices, and those samples
# are `#if DEBUG`: a claim that holds until somebody moves a declaration out of the
# guarded file, with invented client names and addresses landing inside the app Dan
# runs. The check reads the terms out of the sample sources and proves them PRESENT
# in the Debug product before requiring their absence from Release, because a scan
# whose terms are wrong finds nothing in either and calls Release clean (L159).
# A machine that has built neither product answers CANNOT MEASURE, which gate_check
# allows and names, for the reason the icon check records.
gate_check check-review-samples-absent.sh "the review sheet's samples reached the Release product."

# ovation#143. The workflow carries decisions nothing else in the repository
# reads: a timeout on every job, every action pinned to a commit, and the command
# Dan decided CI runs. Each of those fails silently, and the last one fails while
# leaving a green tick on the board.
gate_check check-ci-workflow.sh "the CI workflow has drifted from what it is for."

# THE LIVE DATA BRACKET IS NOT RUN HERE. It is a bracket around the test run
# rather than a check that can be answered on its own: it snapshots before and
# compares after, and scripts/run-tests.sh holds both ends. Running it here would
# measure a moment rather than a run. (Its filename is deliberately not written
# out in this comment: scripts/test-preconditions.sh reads this file to find
# which checks the gate runs, and a mention would read as one.)
#
# Injectable so scripts/test-git-hooks.sh can measure the GATE without paying for
# a real suite run (L2, L291). The default is the real thing.
# ---------------------------------------------------------------------------
# WHETHER THE XCODE PHASE CAN BE SKIPPED FOR THIS PUSH (ovation#22).
#
# Measured twice on 2026-09-05, four minutes each time: this hook ran the runner,
# which waited on Overture's lock while a real Overture suite ran. Overture runs
# its suite constantly, so that is the normal case rather than bad luck, and most
# pushes in this phase change only documentation or shell scripts, which no
# xcodebuild run can read.
#
# ONLY THIS HOOK KNOWS WHAT IS BEING PUSHED. git hands it one line per ref on
# stdin, so the decision is made here and the runner only carries it out.
#
# IT FAILS CLOSED, and that is the whole design. The skippable set is a short
# list of paths nothing in an Xcode build or test can read; everything else, and
# every range this cannot place, runs the full thing. The list is written as what
# may be SKIPPED rather than what must be RUN, because a run set is a list of
# everything somebody thought of and its omissions are silent (L96).
ZERO_SHA="0000000000000000000000000000000000000000"
EMPTY_TREE="$(git hash-object -t tree /dev/null 2>/dev/null)"
PUSHED_PATHS=""
RANGE_UNKNOWN=""
SAW_A_REF=""

# STDIN IS ONLY READ WHEN SOMETHING IS FEEDING IT. git always does; a person
# running this by hand does not, and an unguarded `read` there waits for ever.
# A hang is worse than a failure because it cannot be told from slowness, and
# this one was staged the moment the loop was written: the suite went from
# seconds to a timeout (L110).
if [ -t 0 ]; then
    RANGE_UNKNOWN=1
fi

while [ -z "${RANGE_UNKNOWN}" ] && read -r _local_ref local_sha _remote_ref remote_sha; do
    SAW_A_REF=1
    if [ -z "${local_sha:-}" ] || [ -z "${remote_sha:-}" ] || [ "${local_sha}" = "${ZERO_SHA}" ]; then
        # A deletion, or a line this cannot read. Neither is a claim about content.
        RANGE_UNKNOWN=1
        break
    fi
    base=""
    if [ "${remote_sha}" != "${ZERO_SHA}" ] && git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
        base="${remote_sha}"
    else
        # A branch the remote does not have yet. What is actually being added is
        # what is not on any remote, and in a repository with no remote at all
        # that is every commit, which lands on the empty tree and therefore on
        # every file: the full run, which is the right answer there.
        oldest="$(git rev-list "${local_sha}" --not --remotes 2>/dev/null | tail -1)"
        if [ -n "${oldest}" ]; then
            base="$(git rev-parse -q --verify "${oldest}^" 2>/dev/null)"
            base="${base:-${EMPTY_TREE}}"
        fi
    fi
    if [ -z "${base}" ]; then
        RANGE_UNKNOWN=1
        break
    fi
    if ! paths="$(git diff --name-only "${base}" "${local_sha}" 2>/dev/null)"; then
        RANGE_UNKNOWN=1
        break
    fi
    PUSHED_PATHS="${PUSHED_PATHS}${paths}
"
done

[ -n "${SAW_A_REF}" ] || RANGE_UNKNOWN=1


# WHAT THE XCODE PHASE READS IS DERIVED FROM THE PUSHED TREE (ovation#358).
#
# This was a fixed list of paths no build could open. ovation#154 took scripts/
# off it, because the build command lives there, and rejected narrowing the
# entry because a list of the scripts that cannot reach a build is a registry
# somebody has to keep honest for ever (L27, L96). That left every design and
# shell change paying the whole phase: seven changes on 2026-09-15, about twenty
# five minutes a push, and not one of them touched anything the app builds from.
# The same list also called docs/ unreadable while three Swift tests open files
# in docs/design/ (L88).
#
# scripts/lib/xcode-phase-inputs.sh works the answer out instead: the scripts
# the runner and every xcodebuild caller reach through their code, the paths the
# Swift files name, and the old short list for everything else. The reasoning,
# and what a text search cannot see, live there once rather than here as well.
#
# A TREE WITHOUT THE LIB IS REFUSED, like the built product lib below and for the
# same reason: the hook and the lib come from one revision (ovation#138), so its
# absence is an inconsistent tree, and deciding without it would be a skip nobody
# decided. A lib that is there and CANNOT answer runs everything instead, because
# that is a question about this push rather than a fault in the tree.
INPUTS_LIB="${REPO_ROOT}/scripts/lib/xcode-phase-inputs.sh"
if [ ! -f "${INPUTS_LIB}" ]; then
    echo "pre-push: scripts/lib/xcode-phase-inputs.sh is not in ${REPO_ROOT}, so this" >&2
    echo "pre-push: gate cannot tell what the Xcode phase reads. Push refused." >&2
    exit 1
fi
# shellcheck source=../lib/xcode-phase-inputs.sh
. "${INPUTS_LIB}"

INPUTS_UNKNOWN=""
FIRST_RELEVANT=""
RELEVANT_WHY=""
PATH_COUNT=0
if [ -z "${RANGE_UNKNOWN}" ]; then
    if ! xcode_phase_inputs_load "${REPO_ROOT}"; then
        INPUTS_UNKNOWN="${XPI_ERROR}"
    else
        while IFS= read -r one; do
            [ -n "${one}" ] || continue
            PATH_COUNT=$((PATH_COUNT+1))
            if [ -z "${FIRST_RELEVANT}" ] && xcode_phase_reads "${one}"; then
                FIRST_RELEVANT="${one}"
                RELEVANT_WHY="${XPI_WHY}"
            fi
        done <<< "${PUSHED_PATHS}"
    fi
fi

SKIP_XCODE=""
if [ -n "${RANGE_UNKNOWN}" ]; then
    echo "pre-push: could not work out what this push contains, so the full suite" >&2
    echo "pre-push: runs. That is the safe direction, not a fault." >&2
elif [ -n "${INPUTS_UNKNOWN}" ]; then
    echo "pre-push: could not work out what the Xcode phase reads, so the full suite" >&2
    echo "pre-push: runs: ${INPUTS_UNKNOWN}" >&2
elif [ -n "${FIRST_RELEVANT}" ]; then
    echo "pre-push: ${FIRST_RELEVANT} is in this push, so the full suite runs." >&2
    echo "pre-push: the Xcode phase reads it: ${RELEVANT_WHY}." >&2
else
    SKIP_XCODE=1
    echo "pre-push: ${PATH_COUNT} path(s) in this push, none of them read by the Xcode" >&2
    echo "pre-push: phase, so skipping the Xcode phase and the wait for the sibling" >&2
    echo "pre-push: locks. The shell suites still run." >&2
fi

TEST_COMMAND="${OVATION_HOOK_TEST_COMMAND:-}"

# ---------------------------------------------------------------------------
# A PUSH THAT WILL NEED BUILT PRODUCTS IS REFUSED BEFORE ANYTHING RUNS
# (ovation#273).
#
# The refusal below, for a suite that could not measure, is the rule. But it is
# learned at the END: after every shell suite, after the wait for the sibling
# locks, after the pure and hosted suites. Measured 2026-09-13, two branches in
# fresh worktrees each waited several minutes, once behind a sibling's build, to
# be told to run build-products.sh, and each doomed push was stopped by hand.
#
# So when the Xcode phase is going to run, both configurations are asked for
# first, through scripts/lib/built-product.sh: the same location query and the
# same test for "built" the two bundle suites refuse by. That is what makes this
# an earlier answer to the late refusal's question rather than a second rule that
# can disagree with it (L70, L667). It is a strict subset of the late refusal:
# products missing means those suites cannot measure, so this refuses only a push
# the late refusal was certain to refuse.
#
# NOT ASKED WHEN THE COMMAND IS INJECTED. The early refusal exists to save the
# cost of a real run, and an injected command is no real run; the late rule still
# judges its status, as it always did.
#
# A TREE WITHOUT THE LIB IS REFUSED, NOT SKIPPED. The hook and the lib come from
# the same revision (ovation#138), so its absence is an inconsistent tree, and
# skipping would be the gate dropping a check while still reporting green (L96).
if [ -z "${SKIP_XCODE}" ] && [ -z "${TEST_COMMAND}" ]; then
    PRODUCT_LIB="${REPO_ROOT}/scripts/lib/built-product.sh"
    if [ ! -f "${PRODUCT_LIB}" ]; then
        echo "pre-push: scripts/lib/built-product.sh is not in ${REPO_ROOT}, so this gate" >&2
        echo "pre-push: cannot tell whether the products this push needs are built." >&2
        echo "pre-push: Push refused." >&2
        exit 1
    fi
    # shellcheck source=../lib/built-product.sh
    . "${PRODUCT_LIB}"
    PRODUCTS_MISSING=""
    PRODUCT_REMEDIES=""
    for config in ${BUILT_PRODUCT_CONFIGURATIONS}; do
        # From the top of the pushed tree, which is where the location query
        # expects to find the project. The project it asked is passed on, so a
        # location that was never learned is reported as that (ovation#309).
        app="$(cd "${REPO_ROOT}" && built_product_path "${config}")/Ovation.app"
        reason="$(built_product_absence "${config}" "${app}" "${REPO_ROOT}/Ovation.xcodeproj")"
        code=$?
        [ "${code}" -eq 0 ] && continue
        PRODUCTS_MISSING="${PRODUCTS_MISSING}pre-push:     ${reason}
"
        # EACH REMEDY ONCE, from the lib, so both configurations missing for one
        # reason print one command rather than the same command twice.
        remedy="$(built_product_remedy "${code}")"
        case "${PRODUCT_REMEDIES}" in
            *"${remedy}"*) ;;
            *) PRODUCT_REMEDIES="${PRODUCT_REMEDIES}pre-push:     ${remedy}
" ;;
        esac
    done
    if [ -n "${PRODUCTS_MISSING}" ]; then
        echo "pre-push: this push contains something the built bundle suites judge, and" >&2
        echo "pre-push: they cannot measure a product that is not there:" >&2
        printf '%s' "${PRODUCTS_MISSING}" >&2
        echo "pre-push: Push refused before running anything, rather than after the whole" >&2
        echo "pre-push: suite. Run this, then push again:" >&2
        printf '%s' "${PRODUCT_REMEDIES}" >&2
        exit 1
    fi
fi

if [ -n "${TEST_COMMAND}" ]; then
    bash -c "${TEST_COMMAND}"
else
    OVATION_SKIP_XCODE_PHASE="${SKIP_XCODE}" "${REPO_ROOT}/scripts/run-tests.sh"
fi
STATUS=$?

# THE SUITE ANSWERS THE SAME THREE WAYS (ovation#139). run-tests.sh returns 2
# when every suite that could run passed and at least one could not measure,
# which on a tree with no built product is the two bundle suites. Refusing there
# would mean no push at all, not even a docs change, until both configurations
# are built under the sibling locks, which is the cost ovation#139 was filed
# about. It is allowed and NAMED, never called green.
if [ "${STATUS}" -eq 2 ] && [ -n "${SKIP_XCODE}" ]; then
    # This machine COULD have measured those suites, it simply has not built
    # anything yet, so Dan's rule turns on whether the push contains anything
    # they judge. It does not: the same answer the Xcode phase decision was made
    # from is read again here rather than a second rule that can disagree with
    # the first (L70).
    echo "pre-push: the suite could not be measured in full (see above)." >&2
    echo "pre-push: everything that could run passed, and nothing in this push is" >&2
    echo "pre-push: something those suites judge, so it is not refused for them." >&2
    UNMEASURED="${UNMEASURED}the test suite "
elif [ "${STATUS}" -eq 2 ]; then
    # The other half, and the one the rule is actually about. A range this could
    # not place lands here too, because not knowing what is in a push is not the
    # same as knowing there is nothing in it (L98).
    echo "pre-push: the suite could not be measured in full (see above), and this" >&2
    echo "pre-push: push contains something those suites judge. Push refused." >&2
    echo "pre-push: build both configurations first, which is what makes them" >&2
    echo "pre-push: measurable: bash scripts/build-products.sh" >&2
    exit 1
elif [ "${STATUS}" -ne 0 ]; then
    echo "pre-push: the suite is RED. Push refused." >&2
    echo "pre-push: fix it, or push this one time with SKIP_TEST_RUN=1, which says so." >&2
    exit 1
else
    echo "pre-push: unit suite is green." >&2
fi

# SAID ONCE MORE AT THE END, because the notice that mattered scrolled past
# several minutes of suite output and the last line is the one that gets read.
if [ -n "${UNMEASURED}" ]; then
    echo "pre-push: allowed, with these unmeasured on this machine: ${UNMEASURED% }" >&2
fi
exit 0
