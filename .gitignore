# PROVISIONAL. ovation#4 replaces this file with Downbeat's, plus Ovation's own
# custody exclusions (.receipt-samples and .quickbooks-samples) and the check
# that neither has ever been staged. What is here is only what ovation#8 needs
# in order to ship at all: a generated project and the build output.
#
# Every entry carries its reason, per ovation#4. An entry with no reason, sitting
# beside neighbours that have one, is evidence nobody reasoned about it (L233).

# macOS writes these into every directory it displays.
.DS_Store

# GENERATED by XcodeGen from project.yml, which is the source of truth. Committing
# it would give the repository two descriptions of the same project that drift
# silently, and the generated one is the copy Xcode actually reads (L41).
Ovation.xcodeproj/

# Build output. xcodebuild writes to DerivedData by default, but a scheme query
# or an explicit -derivedDataPath can put it here instead.
build/
DerivedData/

# Per user Xcode state: window positions, breakpoints, the last scheme selected.
# Nothing about it is shared.
xcuserdata/
*.xcuserstate

# Swift Package Manager working directories.
.build/
.swiftpm/
